# Database — prefer Neon Free (https://neon.tech). Avoid Fly Managed Postgres for cost.
# When unset, PGLite + localStorage are used.
DATABASE_URL=

# xAI API key — server credential for Grok Build headless generation (falls back to local templates when unset).
# With per-user xAI sign-in enabled (below), it is only used when XAI_SERVER_KEY_FALLBACK=true.
XAI_API_KEY=

# Grok Build (CLI headless agent) — primary path for design generation + designer replies
# Optional absolute path to the grok binary (defaults: PATH, then common install locations)
GROK_BUILD_BIN=
# Set to true to skip Build and use legacy chat completions (or local templates without a key)
GROK_BUILD_DISABLED=
# Set to true to fall back to api.x.ai chat completions when Build fails / binary missing
GROK_BUILD_ALLOW_API_FALLBACK=

# Auth — set VITE_AUTH_ENABLED=false to force the shared dev user everywhere
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://grok-design.fly.dev
BETTER_AUTH_SECRET=

# Grok auth broker (deployed per-app client). Preview can use GROK_PREVIEW_* instead.
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Shared live-preview OAuth client (optional; disables federation when unset)
GROK_PREVIEW_CLIENT_SECRET=

# ── Per-user xAI sign-in ("Connect xAI" — users generate on their own xAI / SuperGrok account) ──
# OFF unless CLIENT_ID + SCOPE + TOKEN_ENC_KEY are all set. xAI has no public client registration:
# use a client xAI issued for Grok Design (never the Grok CLI's own client id). Client ids are UUIDs.
XAI_OAUTH_CLIENT_ID=
# Optional: confidential client secret (sent with client_secret_basic). Leave empty for a public client.
XAI_OAUTH_CLIENT_SECRET=
# Space-separated scopes; `openid` is always added. Exact Grok Build scope is still to be confirmed with xAI.
# Example: openid email offline_access grok-cli:access
XAI_OAUTH_SCOPE=
# AES-256-GCM key for tokens at rest: 32 bytes as base64 or hex (`openssl rand -base64 32`).
# Rotation: "k2:<new>,k1:<old>" (first entry encrypts, all decrypt). Never reuse BETTER_AUTH_SECRET.
XAI_TOKEN_ENC_KEY=
# Optional: fixed redirect URI registered with xAI; enables the redirect (auth-code + PKCE) flow.
# Must be exact, e.g. https://grok-design.fly.dev/api/xai/oauth/callback (preview deploys: leave empty).
XAI_OAUTH_REDIRECT_URI=
# Optional: set to false to hide the device-code ("use a code") flow.
XAI_OAUTH_DEVICE_FLOW=
# Optional: let users without a working xAI connection generate on XAI_API_KEY (default false when sign-in is on).
XAI_SERVER_KEY_FALLBACK=
# Optional: issuer override (default https://auth.x.ai; must be https).
XAI_OAUTH_ISSUER=
# Optional: extra env var NAMES to pass to the Grok child (e.g. HTTPS_PROXY,NO_PROXY). Secret-like names are refused.
GROK_BUILD_EXTRA_ENV=
